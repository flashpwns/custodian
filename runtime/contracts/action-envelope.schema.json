{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custodian.dev/schemas/runtime/action-envelope/v1",
  "title": "Custodian Action Envelope v1",
  "description": "A proposed action with an explicit deterministic position in simulation time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action_id", "session_id", "actor_id", "at", "priority", "kind", "payload"],
  "properties": {
    "action_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "at": { "type": "integer", "minimum": 0 },
    "priority": { "type": "integer" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@v[1-9][0-9]*$" },
    "payload": { "type": "object" }
  }
}
