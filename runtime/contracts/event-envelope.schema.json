{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custodian.dev/schemas/runtime/event-envelope/v3",
  "title": "Custodian Event Envelope v3",
  "description": "An immutable, ordered change to objective reality or recorded information flow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "session_id", "sequence", "type", "occurred_at", "simulation_time", "timeline", "payload", "world"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "session_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@v[1-9][0-9]*$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "simulation_time": {
      "description": "Monotonic session time in milliseconds; separate from wall-clock persistence time.",
      "type": "integer",
      "minimum": 0
    },
    "timeline": {
      "description": "Durable total-order fields used for deterministic replay at simulation_time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "priority", "stable_id"],
      "properties": {
        "phase": { "enum": ["scheduled", "action", "consequence", "observation", "narration"] },
        "priority": { "type": "integer" },
        "stable_id": { "type": "string", "minLength": 1 }
      }
    },
    "actor_id": { "type": "string", "minLength": 1 },
    "causation_id": { "type": "string", "format": "uuid" },
    "causal_parents": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true },
    "correlation_id": { "type": "string", "format": "uuid" },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
      }
    },
    "payload": { "type": "object" },
    "effect": {
      "description": "Declares which constitutional layer the event is permitted to change.",
      "enum": ["objective_reality", "information_path", "epistemic_state", "administrative"]
    },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
