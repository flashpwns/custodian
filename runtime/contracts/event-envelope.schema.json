{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custodian.dev/schemas/runtime/event-envelope/v1",
  "title": "Custodian Event Envelope v1",
  "description": "An immutable, ordered change to a Custodian session.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "session_id", "sequence", "type", "occurred_at", "payload", "world"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "session_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@v[1-9][0-9]*$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor_id": { "type": "string", "minLength": 1 },
    "causation_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
      }
    },
    "payload": { "type": "object" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
