{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custodian.dev/schemas/state/session-state/v1",
  "title": "Custodian Session State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "world", "projected_through", "entities", "facts"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "session_id": { "type": "string", "minLength": 1 },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "projected_through": { "type": "integer", "minimum": 0 },
    "entities": { "type": "object", "additionalProperties": { "type": "object" } },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "status", "source_event"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "status": { "enum": ["observed", "reported", "inferred", "disputed"] },
          "source_event": { "type": "string", "format": "uuid" }
        }
      }
    },
    "world_state": { "type": "object", "additionalProperties": true }
  }
}
