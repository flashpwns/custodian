{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custodian.dev/schemas/state/session-state/v8",
  "title": "Custodian Session State v8",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "world", "projected_through", "simulation_time", "timeline", "entities", "objective_reality", "evidence", "observers", "agents", "memories", "relationships", "messages"],
  "properties": {
    "schema_version": { "const": "8.0.0" },
    "session_id": { "type": "string", "minLength": 1 },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "projected_through": { "type": "integer", "minimum": 0 },
    "simulation_time": { "type": "integer", "minimum": 0 },
    "timeline": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution_policy", "pending"],
      "properties": {
        "resolution_policy": { "const": "time-phase-priority-stable-id@v1" },
        "pending": { "type": "array", "items": { "$ref": "#/$defs/scheduled_event" } }
      }
    },
    "entities": { "type": "object", "additionalProperties": { "type": "object" } },
    "objective_reality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "value", "source_event", "valid_from"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "value": {},
              "source_event": { "type": "string", "format": "uuid" },
              "valid_from": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "information_paths": { "type": "array", "items": { "type": "object" } },
    "observers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["perceptions", "knowledge", "beliefs"],
        "properties": {
          "perceptions": { "type": "array", "items": { "$ref": "#/$defs/perception" } },
          "knowledge": { "type": "array", "items": { "$ref": "#/$defs/knowledge" } },
          "beliefs": { "type": "array", "items": { "$ref": "#/$defs/belief" } }
        }
      }
    },
    "agents": { "type": "object", "additionalProperties": { "$ref": "#/$defs/agent" } },
    "memories": { "type": "array", "items": { "$ref": "#/$defs/memory" } },
    "relationships": { "type": "array", "items": { "type": "object" } },
    "messages": { "type": "array", "items": { "type": "object" } },
    "world_state": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "perception": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "content", "path_id"],
      "properties": { "id": { "type": "string" }, "content": { "type": "string" }, "path_id": { "type": "string" } }
    },
    "knowledge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "proposition", "path_id"],
      "properties": { "id": { "type": "string" }, "proposition": { "type": "string" }, "path_id": { "type": "string" } }
    },
    "belief": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "proposition", "value", "basis_ids", "confidence"],
      "properties": {
        "id": { "type": "string" }, "proposition": { "type": "string" }, "value": {},
        "basis_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "scheduled_event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "due_at", "type", "payload", "scheduled_by", "priority"],
      "properties": {
        "id": { "type": "string" }, "due_at": { "type": "integer", "minimum": 0 },
        "type": { "type": "string" }, "payload": { "type": "object" }, "scheduled_by": { "type": "string", "format": "uuid" },
        "priority": { "type": "integer" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "origin_event", "created_at", "availability", "completeness", "fidelity", "provenance", "claims"],
      "properties": {
        "id": { "type": "string" }, "kind": { "enum": ["recording", "artifact", "environmental_trace", "sensor_output", "durable_record"] },
        "origin_event": { "type": "string", "format": "uuid" }, "created_at": { "type": "integer", "minimum": 0 },
        "availability": { "enum": ["available", "damaged", "destroyed"] }, "destroyed_by": { "type": "string", "format": "uuid" },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 }, "fidelity": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "enum": ["captured", "collected", "generated", "forged"] },
        "claims": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["goals", "intentions", "plans"],
      "properties": {
        "goals": { "type": "array", "items": { "type": "object" } },
        "intentions": { "type": "array", "items": { "type": "object" } },
        "plans": { "type": "array", "items": { "type": "object" } }
      }
    },
    "memory": {
      "type": "object", "required": ["id", "agent_id", "content", "formed_from", "formed_at", "confidence", "availability"],
      "properties": { "id": { "type": "string" }, "agent_id": { "type": "string" }, "content": { "type": "string" }, "formed_from": { "type": "string" }, "formed_at": { "type": "integer" }, "confidence": { "type": "number" }, "availability": { "enum": ["active", "forgotten"] } }
    }
  }
}
