{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custodian.dev/schemas/state/session-state/v3",
  "title": "Custodian Session State v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "world", "projected_through", "simulation_time", "timeline", "entities", "objective_reality", "observers"],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "session_id": { "type": "string", "minLength": 1 },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "projected_through": { "type": "integer", "minimum": 0 },
    "simulation_time": { "type": "integer", "minimum": 0 },
    "timeline": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution_policy", "pending"],
      "properties": {
        "resolution_policy": { "const": "time-phase-priority-stable-id@v1" },
        "pending": { "type": "array", "items": { "$ref": "#/$defs/scheduled_event" } }
      }
    },
    "entities": { "type": "object", "additionalProperties": { "type": "object" } },
    "objective_reality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "value", "source_event", "valid_from"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "value": {},
              "source_event": { "type": "string", "format": "uuid" },
              "valid_from": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "information_paths": { "type": "array", "items": { "type": "object" } },
    "observers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["perceptions", "knowledge", "beliefs"],
        "properties": {
          "perceptions": { "type": "array", "items": { "$ref": "#/$defs/perception" } },
          "knowledge": { "type": "array", "items": { "$ref": "#/$defs/knowledge" } },
          "beliefs": { "type": "array", "items": { "$ref": "#/$defs/belief" } }
        }
      }
    },
    "world_state": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "perception": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "content", "path_id"],
      "properties": { "id": { "type": "string" }, "content": { "type": "string" }, "path_id": { "type": "string" } }
    },
    "knowledge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "proposition", "path_id"],
      "properties": { "id": { "type": "string" }, "proposition": { "type": "string" }, "path_id": { "type": "string" } }
    },
    "belief": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "proposition", "value", "basis_ids", "confidence"],
      "properties": {
        "id": { "type": "string" }, "proposition": { "type": "string" }, "value": {},
        "basis_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "scheduled_event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "due_at", "type", "payload", "scheduled_by", "priority"],
      "properties": {
        "id": { "type": "string" }, "due_at": { "type": "integer", "minimum": 0 },
        "type": { "type": "string" }, "payload": { "type": "object" }, "scheduled_by": { "type": "string", "format": "uuid" },
        "priority": { "type": "integer" }
      }
    }
  }
}
